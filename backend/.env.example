# These loopback URLs are for host development. Compose supplies its own internal primary database and Redis URLs.
DATABASE_URL=postgresql+psycopg://insightforge_app:replace_with_local_app_password@localhost:5432/insightforge
MIGRATION_DATABASE_URL=postgresql+psycopg://insightforge_owner:replace_with_local_owner_password@localhost:5432/insightforge
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]
COOKIE_SECURE=false
REPORTING_DATABASE_URL=
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
REPORT_STORAGE=local
REPORT_DIRECTORY=.private-reports
REPORT_S3_BUCKET=
